{
  "name": "mcp-oauth-proxy",
  "version": "0.3.3",
  "description": "Local stdio MCP OAuth-aware router for multiple HTTP MCP upstreams",
  "type": "module",
  "main": "dist/src/main.js",
  "bin": {
    "mcp-oauth-proxy": "dist/src/main.js"
  },
  "files": [
    "dist/src/",
    "skills/",
    "config.example.json",
    "README.md",
    "plugin.json",
    "package.json",
    "tsconfig.json"
  ],
  "scripts": { "build": "tsc -p tsconfig.json", "prepare": "npm run build", "start": "node dist/src/main.js", "build:exe": "npm run build && pkg dist/src/main.js --targets node22-win-x64 --output dist/mcp-oauth-proxy.exe", "test": "npm run build && node --test dist/tests/*.test.js" },
  "engines": { "node": ">=20" },
  "repository": {
    "type": "git",
    "url": "https://github.com/aliyoussefi/mcp-oauth-proxy.git"
  },
  "keywords": ["mcp", "oauth", "proxy", "salesforce", "dataverse", "slack"],
  "license": "MIT",
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.6.0", "@yao-pkg/pkg": "^6.22.0" }
}
